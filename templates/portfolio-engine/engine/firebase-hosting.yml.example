name: Deploy portfolio

on:
  push:
    branches:
      - REPLACE_WITH_PRODUCTION_BRANCH

permissions:
  contents: read

concurrency:
  group: portfolio-production
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Generate media catalog
        run: node engine/generate-media-manifest.mjs
      - uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          firebaseServiceAccount: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          projectId: REPLACE_WITH_FIREBASE_PROJECT_ID
          channelId: live
      - uses: google-github-actions/auth@v3
        with:
          credentials_json: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          project_id: REPLACE_WITH_FIREBASE_PROJECT_ID
      - name: Deploy Firestore rules
        run: |
          npm install --global firebase-tools
          firebase deploy --only firestore:rules --project REPLACE_WITH_FIREBASE_PROJECT_ID --non-interactive
