rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{document} {
      allow get: if document == 'public';
      allow list: if false;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }
  }
}
