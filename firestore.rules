rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{document} {
      // The published site configuration can be read by visitors.
      allow get: if document == 'public';
      allow list: if false;

      // Replace this value with the administrator's Firebase Auth UID.
      // Do not loosen this rule to allow all signed-in users.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }
  }
}
