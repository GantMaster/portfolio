rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{document} {
      // The published site configuration can be read by visitors.
      allow get: if document == 'public';
      allow list: if false;

      // Only the designated administrator may change portfolio content.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'WlMbCDZI8aX3vNCe5YGLdpl2dy33';
    }
  }
}
